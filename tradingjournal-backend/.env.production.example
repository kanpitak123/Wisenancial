# ==============================================================================
# Wisenancial — Backend production environment
# ==============================================================================
# คัดลอกไฟล์นี้เป็น .env บนเซิร์ฟเวอร์จริงแล้วเติมค่า **ห้าม commit ไฟล์ .env ที่มีค่าจริง**
#
# ตัวแปรที่ทำเครื่องหมาย [REQUIRED] ต้องมีค่าทุกตัว ไม่งั้นแอปจะไม่ทำงาน (บางตัวตั้งใจ
# ให้ล้มตั้งแต่ boot ดีกว่าไปพังตอนมีผู้ใช้จริง)
# ตัวที่เป็น [OPTIONAL] ถ้าไม่ใส่ ฟีเจอร์ที่เกี่ยวข้องจะปิดตัวเองอย่างสุภาพ ไม่ทำให้แอปพัง
# ==============================================================================

# ── Runtime ───────────────────────────────────────────────────────────────────
# [REQUIRED] ต้องเป็น "production" — โค้ดหลายจุดใช้ค่านี้ตัดสินใจเรื่องความปลอดภัย
# เช่น CORS จะไม่ยอมถอยไปใช้ localhost ให้อีกต่อไป
NODE_ENV=production

# [OPTIONAL] พอร์ตที่ Nest จะ bind — ผู้ให้บริการโฮสต์ส่วนใหญ่กำหนดค่านี้มาให้เอง
# และจะฆ่าโปรเซสที่ไป bind พอร์ตอื่น ปล่อยว่างไว้ถ้าโฮสต์ตั้งให้ (ดีฟอลต์ 3000)
PORT=

# [OPTIONAL] เลขเวอร์ชันที่ /health คืนกลับไป ช่วยยืนยันว่า deploy ขึ้นจริงหรือยัง
APP_VERSION=

# ── Database (Prisma) ─────────────────────────────────────────────────────────
# [REQUIRED] connection string หลัก — บน Supabase ให้ใช้ pooler (พอร์ต 6543)
# รูปแบบ: postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DATABASE_URL=

# [REQUIRED] connection ตรงไม่ผ่าน pooler (พอร์ต 5432) — prisma migrate ต้องใช้ตัวนี้
# ถ้าชี้ไป pooler การ migrate จะค้างหรือพังกลางคัน
DIRECT_URL=

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# [REQUIRED] ความลับสำหรับเซ็น access token — สุ่มอย่างน้อย 32 ไบต์
# สร้างด้วย: openssl rand -base64 48
JWT_ACCESS_SECRET=

# [REQUIRED] ความลับสำหรับ refresh token — **ต้องเป็นคนละดอกกับ access secret**
# ใช้ดอกเดียวกันเมื่อไหร่ refresh token จะถูกใช้แทน access token ได้ทันที
JWT_REFRESH_SECRET=

# [OPTIONAL] อายุ access token (ดีฟอลต์ควรตั้ง 900 = 15 นาที)
# ยิ่งสั้นยิ่งปลอดภัย เพราะมี refresh flow รองรับอยู่แล้ว
JWT_ACCESS_EXPIRES_IN=900

# [OPTIONAL] อายุ refresh token เช่น 30d
JWT_REFRESH_EXPIRES=30d

# ⚠️ JWT_SECRET (ตัวเก่า ไม่มี ACCESS/REFRESH ต่อท้าย) เลิกใช้แล้ว — อย่าใส่กลับมา
# ระบบ chat WS เคยใช้ตัวนี้และถูกย้ายไปใช้ JWT_ACCESS_SECRET แล้ว

# ── CORS ──────────────────────────────────────────────────────────────────────
# [REQUIRED] รายชื่อ origin ที่อนุญาต คั่นด้วย comma ไม่ต้องเว้นวรรค
#   ตัวอย่าง: https://app.wisenancial.com,https://www.wisenancial.com
# ห้ามใส่ "*" เด็ดขาด — refresh token อยู่ใน httpOnly cookie ซึ่งต้องใช้ credentials
# และสเปก CORS ห้าม credentials คู่กับ "*" (แอปจะ throw ตั้งแต่ boot ถ้าเจอ)
# ถ้าไม่ตั้งค่านี้ตอน NODE_ENV=production แอปจะไม่ยอมสตาร์ท
CORS_ORIGINS=

# [OPTIONAL] URL หน้าบ้าน ใช้เป็น redirect ปลายทางของ Stripe checkout
# และถูกใช้เป็น CORS origin สำรองถ้าไม่ได้ตั้ง CORS_ORIGINS
FRONTEND_URL=

# [OPTIONAL] URL สาธารณะของ API ตัวเอง ใช้ประกอบลิงก์ในอีเมล/ไฟล์อัปโหลด
API_PUBLIC_URL=

# ── Rate limiting (@nestjs/throttler) ─────────────────────────────────────────
# [OPTIONAL] ความยาวหน้าต่างเวลาเป็นวินาที (ดีฟอลต์ 60)
THROTTLE_TTL_SECONDS=60

# [OPTIONAL] จำนวนคำขอสูงสุดต่อหน้าต่างต่อ IP (ดีฟอลต์ 120)
# หน้า Dashboard ยิงหลาย endpoint พร้อมกันตอนโหลด ถ้าตั้งต่ำกว่า ~60 ผู้ใช้ปกติจะโดนบล็อก
THROTTLE_LIMIT=120

# [OPTIONAL] เพดานเฉพาะ /auth/login, /auth/register, /auth/refresh (ดีฟอลต์ 10 ครั้ง/60 วิ)
# แยกจากเพดานรวมข้างบนเพราะเพดานที่หลวมพอสำหรับหน้า Dashboard คือเพดานที่หลวมเกินไป
# สำหรับการเดารหัสผ่าน — ตัวเลขนี้นับต่อ IP และผู้ใช้จำนวนมากอยู่หลัง NAT ร่วมกัน
# ถ้าตั้งต่ำกว่า ~5 เสี่ยงล็อกคนทั้งออฟฟิศเพราะมีคนพิมพ์รหัสผิดไม่กี่ครั้ง
AUTH_THROTTLE_TTL_SECONDS=60
AUTH_THROTTLE_LIMIT=10

# [OPTIONAL] เพดานเฉพาะ POST /brokers/mt/heartbeat และ /brokers/mt/ingest (ดีฟอลต์ 30
# ครั้ง/60 วิ) — ต่างจากเพดานข้างบนตรงที่นับต่อ broker_connection_id ไม่ใช่ต่อ IP
# (MtConnectionThrottleGuard) เพราะ EA เป็น automated client ตัวเดียวที่ยิงซ้ำๆ จาก
# เครื่องเดียวเสมอ นับต่อ connection แม่นกว่านับต่อ IP ที่อาจมีหลาย EA อยู่หลัง NAT เดียวกัน
MT_INGEST_THROTTLE_TTL_SECONDS=60
MT_INGEST_THROTTLE_LIMIT=30

# ── Stripe ────────────────────────────────────────────────────────────────────
# [OPTIONAL] ไม่ใส่ = ระบบชำระเงินปิดตัวเอง (endpoint ตอบ 503) แอปส่วนอื่นยังทำงานปกติ
# ใช้ key ที่ขึ้นต้นด้วย sk_live_ บน production เท่านั้น
STRIPE_SECRET_KEY=

# [OPTIONAL — แต่จำเป็นถ้าจะรับ webhook] ค่านี้ได้จากหน้า Stripe Dashboard > Webhooks
# ขึ้นต้นด้วย whsec_ ถ้าไม่ใส่ endpoint /payments/webhook จะตอบ 503 ทันที
# โดยไม่แตะข้อมูล (จงใจ — ดีกว่ารับ event ปลอมที่ไม่ได้ยืนยันลายเซ็น)
STRIPE_WEBHOOK_SECRET=

# [OPTIONAL] price id ของแต่ละแพ็กเกจ ต้องตรงกับที่สร้างไว้ใน Stripe
STRIPE_PACK_159_PRICE_ID=
STRIPE_PACK_219_PRICE_ID=
STRIPE_PACK_279_PRICE_ID=
STRIPE_PACK_399_PRICE_ID=

# ── Error monitoring (Sentry) ─────────────────────────────────────────────────
# [OPTIONAL] ไม่ใส่ = error ลง console ตามปกติ แอปทำงานได้เต็มที่
# ⚠️ ตอนนี้ SDK ยังไม่ได้ติดตั้ง (ดู src/monitoring/monitoring.service.ts)
# ใส่ DSN ตอนนี้จะยังไม่ส่งขึ้น Sentry จริง แต่จะมี warning เตือนใน log
SENTRY_DSN=

# [OPTIONAL] สัดส่วน transaction ที่เก็บ performance trace (0 ถึง 1)
SENTRY_TRACES_SAMPLE_RATE=0

# ── AI providers ──────────────────────────────────────────────────────────────
# [OPTIONAL] ใส่อย่างน้อยหนึ่งเจ้า ไม่งั้นฟีเจอร์ AI ทั้งหมดจะใช้ไม่ได้
# (สถานะที่ทราบ ณ ตอนเขียน: groq และ gemini ใช้งานได้ ส่วน openai โควตาหมด
#  และ anthropic key มีปัญหา — ตรวจสอบก่อนขึ้นจริง)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=

# [OPTIONAL] Gemini first-pass news/market_news enrichment (Chunk A of the AI-modules
# integration — see Claude outputs/ai-modules-integration-discovery.md). Replaces the
# hardcoded enrichment prompt with a ported Gemini classifier for background/cron
# enrichment only (never a user-facing endpoint). Default OFF. Requires GEMINI_API_KEY;
# falls back automatically to the existing groq/openai/anthropic chain on any Gemini
# failure, timeout, or malformed/non-compliant output.
GEMINI_NEWS_ENRICHMENT_ENABLED=false

# [OPTIONAL] Shadow guardrails second pass on market_news (Claude, two-sided analysis).
# Separate 10-minute cron; stores the result in market_news.ai_analysis and changes
# nothing user-visible. Default OFF. Needs a valid ANTHROPIC_API_KEY (sk-ant-) AND the
# 20260929000000_add_ai_analysis_to_market_news migration applied first. System-paid
# only (never user credits) and Claude-only (no fallback to another provider).
# Roughly $0.07 and ~47 s per article, so keep the budget small until reviewed.
NEWS_GUARDRAILS_ENABLED=false
# Pick items whose first-pass ai_confidence is below this (importance HIGH always qualifies).
NEWS_GUARDRAILS_CONFIDENCE_THRESHOLD=0.80
# Hard cap on articles analysed per UTC day.
NEWS_GUARDRAILS_DAILY_BUDGET=20
# Articles per 10-minute tick (max 10).
NEWS_GUARDRAILS_BATCH_SIZE=3
# Ignore articles published longer ago than this.
NEWS_GUARDRAILS_MAX_AGE_HOURS=48

# ── Market data ───────────────────────────────────────────────────────────────
# [OPTIONAL] ไม่ใส่ = ราคาหุ้นไม่อัปเดต ส่วนอื่นยังทำงาน
# ⚠️ finnhub.io ถูกบล็อกที่ระดับเครือข่ายในสภาพแวดล้อม dev ปัจจุบัน
# ต้องยืนยันว่าเซิร์ฟเวอร์ production ออกเน็ตไปหา finnhub ได้ก่อนพึ่งพาฟีเจอร์นี้
FINNHUB_API_KEY=

# [OPTIONAL] ข่าวการเงิน ไม่ใส่ = หน้า News ว่าง
NEWS_API_KEY=

# ── Email (password reset / email verification) ───────────────────────────────
# [OPTIONAL] ช่องทางส่งอีเมล ดีฟอลต์ "console" = ไม่ส่งจริง (dev เท่านั้น)
# - dev: พิมพ์ลิงก์ลง log ให้คลิกทดสอบ
# - production: ไม่พิมพ์ลิงก์ลง log เด็ดขาด (ลิงก์ reset ใช้เข้าบัญชีได้) และอีเมลจะไม่ถูกส่ง
# ผู้ให้บริการจริงต้องเพิ่มใน src/mail/mail.module.ts (MAIL_TRANSPORTS) แล้วใส่ชื่อที่นี่
# ค่าที่ไม่รู้จักทำให้แอปไม่ยอมสตาร์ท
# ⚠️ ลิงก์ในอีเมลประกอบจาก FRONTEND_URL (ข้างบน) — ต้องตั้งบน production
MAIL_TRANSPORT=console

# [OPTIONAL] เพดานการส่งอีเมล reset/verify (ดีฟอลต์: 3 ฉบับ/อีเมล/ชั่วโมง, เว้น 60 วิ, 5 ครั้ง/IP/60 วิ)
EMAIL_FLOW_MAX_PER_ADDRESS_PER_HOUR=3
EMAIL_FLOW_RESEND_COOLDOWN_SECONDS=60
EMAIL_FLOW_IP_LIMIT=5
EMAIL_FLOW_IP_TTL_SECONDS=60

# [OPTIONAL] ฟีเจอร์ AI ต้องยืนยันอีเมลก่อน — ดีฟอลต์ปิด (false)
# enable only after a real mail transport is configured
# ⚠️ MAIL_TRANSPORT=console บน production ไม่ส่งอะไรเลย ถ้าเปิดตัวนี้ก่อนตั้งผู้ให้บริการอีเมลจริง
# ผู้ใช้ใหม่จะไม่ได้รับลิงก์ยืนยัน และใช้ AI ไม่ได้ทั้งระบบ
REQUIRE_VERIFIED_EMAIL_FOR_AI=false
