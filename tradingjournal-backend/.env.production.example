# ==============================================================================
# Wisenancial — Backend production environment
# ==============================================================================
# คัดลอกไฟล์นี้เป็น .env บนเซิร์ฟเวอร์จริงแล้วเติมค่า **ห้าม commit ไฟล์ .env ที่มีค่าจริง**
#
# ตัวแปรที่ทำเครื่องหมาย [REQUIRED] ต้องมีค่าทุกตัว ไม่งั้นแอปจะไม่ทำงาน (บางตัวตั้งใจ
# ให้ล้มตั้งแต่ boot ดีกว่าไปพังตอนมีผู้ใช้จริง)
# ตัวที่เป็น [OPTIONAL] ถ้าไม่ใส่ ฟีเจอร์ที่เกี่ยวข้องจะปิดตัวเองอย่างสุภาพ ไม่ทำให้แอปพัง
# ==============================================================================

# ── Runtime ───────────────────────────────────────────────────────────────────
# [REQUIRED] ต้องเป็น "production" — โค้ดหลายจุดใช้ค่านี้ตัดสินใจเรื่องความปลอดภัย
# เช่น CORS จะไม่ยอมถอยไปใช้ localhost ให้อีกต่อไป
NODE_ENV=production

# [OPTIONAL] พอร์ตที่ Nest จะ bind — ผู้ให้บริการโฮสต์ส่วนใหญ่กำหนดค่านี้มาให้เอง
# และจะฆ่าโปรเซสที่ไป bind พอร์ตอื่น ปล่อยว่างไว้ถ้าโฮสต์ตั้งให้ (ดีฟอลต์ 3000)
PORT=

# [OPTIONAL] เลขเวอร์ชันที่ /health คืนกลับไป ช่วยยืนยันว่า deploy ขึ้นจริงหรือยัง
APP_VERSION=

# ── Database (Prisma) ─────────────────────────────────────────────────────────
# [REQUIRED] connection string หลัก — บน Supabase ให้ใช้ pooler (พอร์ต 6543)
# รูปแบบ: postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DATABASE_URL=

# [REQUIRED] connection ตรงไม่ผ่าน pooler (พอร์ต 5432) — prisma migrate ต้องใช้ตัวนี้
# ถ้าชี้ไป pooler การ migrate จะค้างหรือพังกลางคัน
DIRECT_URL=

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# [REQUIRED] ความลับสำหรับเซ็น access token — สุ่มอย่างน้อย 32 ไบต์
# สร้างด้วย: openssl rand -base64 48
JWT_ACCESS_SECRET=

# [REQUIRED] ความลับสำหรับ refresh token — **ต้องเป็นคนละดอกกับ access secret**
# ใช้ดอกเดียวกันเมื่อไหร่ refresh token จะถูกใช้แทน access token ได้ทันที
JWT_REFRESH_SECRET=

# [OPTIONAL] อายุ access token (ดีฟอลต์ควรตั้ง 900 = 15 นาที)
# ยิ่งสั้นยิ่งปลอดภัย เพราะมี refresh flow รองรับอยู่แล้ว
JWT_ACCESS_EXPIRES_IN=900

# [OPTIONAL] อายุ refresh token เช่น 30d
JWT_REFRESH_EXPIRES=30d

# ⚠️ JWT_SECRET (ตัวเก่า ไม่มี ACCESS/REFRESH ต่อท้าย) เลิกใช้แล้ว — อย่าใส่กลับมา
# ระบบ chat WS เคยใช้ตัวนี้และถูกย้ายไปใช้ JWT_ACCESS_SECRET แล้ว

# ── CORS ──────────────────────────────────────────────────────────────────────
# [REQUIRED] รายชื่อ origin ที่อนุญาต คั่นด้วย comma ไม่ต้องเว้นวรรค
#   ตัวอย่าง: https://app.wisenancial.com,https://www.wisenancial.com
# ห้ามใส่ "*" เด็ดขาด — refresh token อยู่ใน httpOnly cookie ซึ่งต้องใช้ credentials
# และสเปก CORS ห้าม credentials คู่กับ "*" (แอปจะ throw ตั้งแต่ boot ถ้าเจอ)
# ถ้าไม่ตั้งค่านี้ตอน NODE_ENV=production แอปจะไม่ยอมสตาร์ท
CORS_ORIGINS=

# [OPTIONAL] URL หน้าบ้าน ใช้เป็น redirect ปลายทางของ Stripe checkout
# และถูกใช้เป็น CORS origin สำรองถ้าไม่ได้ตั้ง CORS_ORIGINS
FRONTEND_URL=

# [OPTIONAL] URL สาธารณะของ API ตัวเอง ใช้ประกอบลิงก์ในอีเมล/ไฟล์อัปโหลด
API_PUBLIC_URL=

# ── Rate limiting (@nestjs/throttler) ─────────────────────────────────────────
# [OPTIONAL] ความยาวหน้าต่างเวลาเป็นวินาที (ดีฟอลต์ 60)
THROTTLE_TTL_SECONDS=60

# [OPTIONAL] จำนวนคำขอสูงสุดต่อหน้าต่างต่อ IP (ดีฟอลต์ 120)
# หน้า Dashboard ยิงหลาย endpoint พร้อมกันตอนโหลด ถ้าตั้งต่ำกว่า ~60 ผู้ใช้ปกติจะโดนบล็อก
THROTTLE_LIMIT=120

# ── Stripe ────────────────────────────────────────────────────────────────────
# [OPTIONAL] ไม่ใส่ = ระบบชำระเงินปิดตัวเอง (endpoint ตอบ 503) แอปส่วนอื่นยังทำงานปกติ
# ใช้ key ที่ขึ้นต้นด้วย sk_live_ บน production เท่านั้น
STRIPE_SECRET_KEY=

# [OPTIONAL — แต่จำเป็นถ้าจะรับ webhook] ค่านี้ได้จากหน้า Stripe Dashboard > Webhooks
# ขึ้นต้นด้วย whsec_ ถ้าไม่ใส่ endpoint /payments/webhook จะตอบ 503 ทันที
# โดยไม่แตะข้อมูล (จงใจ — ดีกว่ารับ event ปลอมที่ไม่ได้ยืนยันลายเซ็น)
STRIPE_WEBHOOK_SECRET=

# [OPTIONAL] price id ของแต่ละแพ็กเกจ ต้องตรงกับที่สร้างไว้ใน Stripe
STRIPE_PACK_159_PRICE_ID=
STRIPE_PACK_219_PRICE_ID=
STRIPE_PACK_279_PRICE_ID=
STRIPE_PACK_399_PRICE_ID=

# ── Error monitoring (Sentry) ─────────────────────────────────────────────────
# [OPTIONAL] ไม่ใส่ = error ลง console ตามปกติ แอปทำงานได้เต็มที่
# ⚠️ ตอนนี้ SDK ยังไม่ได้ติดตั้ง (ดู src/monitoring/monitoring.service.ts)
# ใส่ DSN ตอนนี้จะยังไม่ส่งขึ้น Sentry จริง แต่จะมี warning เตือนใน log
SENTRY_DSN=

# [OPTIONAL] สัดส่วน transaction ที่เก็บ performance trace (0 ถึง 1)
SENTRY_TRACES_SAMPLE_RATE=0

# ── AI providers ──────────────────────────────────────────────────────────────
# [OPTIONAL] ใส่อย่างน้อยหนึ่งเจ้า ไม่งั้นฟีเจอร์ AI ทั้งหมดจะใช้ไม่ได้
# (สถานะที่ทราบ ณ ตอนเขียน: groq และ gemini ใช้งานได้ ส่วน openai โควตาหมด
#  และ anthropic key มีปัญหา — ตรวจสอบก่อนขึ้นจริง)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=

# ── Market data ───────────────────────────────────────────────────────────────
# [OPTIONAL] ไม่ใส่ = ราคาหุ้นไม่อัปเดต ส่วนอื่นยังทำงาน
# ⚠️ finnhub.io ถูกบล็อกที่ระดับเครือข่ายในสภาพแวดล้อม dev ปัจจุบัน
# ต้องยืนยันว่าเซิร์ฟเวอร์ production ออกเน็ตไปหา finnhub ได้ก่อนพึ่งพาฟีเจอร์นี้
FINNHUB_API_KEY=

# [OPTIONAL] ข่าวการเงิน ไม่ใส่ = หน้า News ว่าง
NEWS_API_KEY=
