# ======================================================
# Backend: NestJS  ->  วางไฟล์จริงที่ tradingjournal-backend/.env
# (ตัวแปรทั้งหมดนี้อ้างอิงจากที่โค้ดอ่านจริงเท่านั้น)
# ======================================================

# --- Database (Supabase PostgreSQL) ---
# runtime: พอร์ต 6543 + pgbouncer=true
DATABASE_URL=
# migrations: พอร์ต 5432 direct
DIRECT_URL=

# --- App ---
NODE_ENV=development
PORT=3000
# ใช้ redirect กลับหน้าเว็บ (billing / payments / share)
FRONTEND_URL=http://localhost:9000
# base URL ของ backend เอง (share-statistics ใช้ประกอบ URL รูป)
API_PUBLIC_URL=http://localhost:3000

# --- JWT ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# ยังไม่มี refresh flow (ไม่มี /auth/refresh) — ตั้งสั้นเกินไปแล้วจะโดนเตะออกกลางคัน
JWT_ACCESS_EXPIRES_IN=604800
# ยังไม่ถูกใช้งานจริง — ไม่มีโค้ดอ่านสองตัวนี้
JWT_REFRESH_EXPIRES=2592000
# chat.module.ts อ่านตัวนี้แยก — ต้องใส่ค่าเดียวกับ JWT_ACCESS_SECRET
JWT_SECRET=

# --- AI Providers ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=

# --- Market Data / News ---
FINNHUB_API_KEY=
NEWS_API_KEY=

# --- OAuth Client IDs ---
GOOGLE_CLIENT_ID=
DISCORD_CLIENT_ID=
X_CLIENT_ID=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PACK_159_PRICE_ID=
STRIPE_PACK_219_PRICE_ID=
STRIPE_PACK_279_PRICE_ID=
STRIPE_PACK_399_PRICE_ID=

# ======================================================
# Frontend: Quasar / Vue
# ======================================================
# ยังไม่ต้องมีไฟล์ .env ฝั่ง frontend ก็รันได้ (default ชี้ localhost:3000 อยู่แล้ว)
#
# ใช้ตอน deploy หรือเวลาจะชี้ไป backend ตัวอื่น — อ่านโดย src/constants/auth.constants.ts
# ห้ามใส่ /api ต่อท้าย ('/api' คือ route ของ Swagger UI ไม่ใช่ prefix ของ API)
VITE_API_URL=

# Mock mode — true = ทุกหน้าแสดงข้อมูลตัวอย่างแทนการยิง backend (ดูหน้าตาได้ครบโดยไม่ต้องมีข้อมูลใน DB)
# ค่านี้เป็นแค่ค่าเริ่มต้น ปุ่ม MOCK บน header จะเขียนทับลง localStorage และชนะเสมอ
VITE_MOCK_MODE=false
#
# หมายเหตุ: src/boot/axios.ts ยัง hardcode baseURL = 'http://localhost:3000' อยู่
# ถ้าจะให้ทั้งแอพอ่าน VITE_API_URL ตัวเดียวกัน ต้องแก้ไฟล์นั้นให้ import API_BASE_URL ด้วย
