# ==============================================================================
# Wisenancial — Frontend production environment (Quasar / Vite)
# ==============================================================================
# คัดลอกไฟล์นี้เป็น .env ตอน build production แล้วเติมค่า
#
# ⚠️ อ่านก่อนใส่ค่า: ตัวแปรที่ขึ้นต้นด้วย VITE_ จะถูก **ฝังลงไฟล์ JavaScript ที่ผู้ใช้
# ดาวน์โหลดได้** ตอน build ทุกคนที่เปิดเว็บอ่านค่าพวกนี้ได้หมด
# ห้ามใส่ API key, secret, หรือ token ใดๆ ที่นี่เด็ดขาด — ของลับทั้งหมดอยู่ฝั่ง backend
# ==============================================================================

# ── API ───────────────────────────────────────────────────────────────────────
# [REQUIRED] URL เต็มของ backend API รวม path /api ถ้ามี
#   ตัวอย่าง: https://api.wisenancial.com/api
#
# ค่านี้ถูกใช้สองที่:
#   1. baseURL ของ axios (src/boot/axios.ts)
#   2. ที่อยู่ WebSocket ของฟีดข่าว — โค้ดตัด /api ท้ายออกให้เอง
#      (src/constants/news.constants.ts)
#
# ต้องเป็น https บน production ไม่งั้นเบราว์เซอร์จะบล็อก mixed content
# และ origin ของค่านี้ต้องอยู่ในรายการ CORS_ORIGINS ฝั่ง backend ด้วย
VITE_API_URL=

# ── Feature flags ─────────────────────────────────────────────────────────────
# [OPTIONAL] โหมด mock ใช้ตอนพัฒนา/รีวิว UI โดยไม่ต่อ backend จริง
# **ต้องเป็น false หรือปล่อยว่างบน production** ไม่งั้นผู้ใช้จะเห็นข้อมูลปลอมทั้งระบบ
VITE_MOCK_MODE=false

# ── Router ────────────────────────────────────────────────────────────────────
# [OPTIONAL] "history" (URL สวย ต้องตั้ง rewrite ที่เว็บเซิร์ฟเวอร์ให้ทุก path
# ตกไปที่ index.html) หรือ "hash" (ไม่ต้องตั้งอะไร แต่ URL มี # คั่น)
# ถ้าเลือก history แล้วลืมตั้ง rewrite ผู้ใช้จะเจอ 404 ทันทีที่กด refresh หน้าลึกๆ
VUE_ROUTER_MODE=history

# [OPTIONAL] path ฐานถ้า deploy ไว้ใต้ subdirectory (เช่น /app/) ปกติปล่อยว่าง
VUE_ROUTER_BASE=
